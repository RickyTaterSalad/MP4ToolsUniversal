<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:vm="using:MP4Tools.ViewModels"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
			 mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="620"
			 x:Class="MP4Tools.Views.LrfInningDetectorView"
			 x:DataType="vm:LrfInningDetectorViewModel">
	<DockPanel DragDrop.AllowDrop="True"
			   Background="Transparent"
			   DragDrop.DragOver="OnDragOver"
			   DragDrop.Drop="OnDrop"
			   LastChildFill="True">

		<StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,8,0,0">
			<ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" Height="8"
						 IsVisible="{Binding ShowProgress}"/>
			<TextBlock Text="{Binding OperationStatus}"
					   TextWrapping="Wrap"
					   Opacity="0.92"/>
			<Grid ColumnDefinitions="Auto,*,Auto">
				<StackPanel Grid.Column="0" Orientation="Horizontal">
					<Button Command="{Binding StopCommand}" Padding="4" IsEnabled="{Binding CanStop}" Margin="0,0,5,0">
						<Button.Content>
							<StackPanel Orientation="Horizontal">
								<materialIcons:MaterialIcon Kind="Stop"/>
								<TextBlock Text="Stop" Margin="5,0,5,0"/>
							</StackPanel>
						</Button.Content>
					</Button>
					<Button Command="{Binding ClearCommand}" Padding="4" IsEnabled="{Binding CanClear}">
						<Button.Content>
							<StackPanel Orientation="Horizontal">
								<materialIcons:MaterialIcon Kind="Remove"/>
								<TextBlock Text="Clear" Margin="5,0,5,0"/>
							</StackPanel>
						</Button.Content>
					</Button>
				</StackPanel>
				<Button Grid.Column="2"
						Command="{Binding DetectCommand}"
						Padding="4"
						IsEnabled="{Binding CanDetect}">
					<Button.Content>
						<StackPanel Orientation="Horizontal">
							<materialIcons:MaterialIcon Kind="Baseball"/>
							<TextBlock Text="Detect from LRF" Margin="5,0,5,0"/>
						</StackPanel>
					</Button.Content>
				</Button>
			</Grid>
		</StackPanel>

		<ScrollViewer>
			<StackPanel Spacing="12">
				<TextBlock Text="Detects half-innings on DJI .LRF proxies, then remaps bookmarks onto the combined MP4 using the Combine edit map (intro + start/end trims). Combine writes a .combine-map.json next to the output video. Sample interval is set under Options → Inning detector (LRF) (default every 3 seconds)."
						   TextWrapping="Wrap"
						   Opacity="0.8"/>

				<Grid ColumnDefinitions="*,Auto">
					<TextBox Grid.Column="0"
							 PlaceholderText="Combined output video (.mp4)"
							 Text="{Binding CombinedVideoPath, UpdateSourceTrigger=PropertyChanged}"
							 Margin="0,0,10,0"/>
					<Button Grid.Column="1" Click="BrowseVideoButton_OnClick" Padding="4">
						<Button.Content>
							<StackPanel Orientation="Horizontal">
								<materialIcons:MaterialIcon Kind="Video"/>
								<TextBlock Text="Browse" Margin="5,0,5,0"/>
							</StackPanel>
						</Button.Content>
					</Button>
				</Grid>

				<Grid ColumnDefinitions="*,Auto">
					<TextBox Grid.Column="0"
							 PlaceholderText="Folder containing .LRF proxy files"
							 Text="{Binding LrfFolderPath, UpdateSourceTrigger=PropertyChanged}"
							 Margin="0,0,10,0"/>
					<Button Grid.Column="1" Click="BrowseFolderButton_OnClick" Padding="4">
						<Button.Content>
							<StackPanel Orientation="Horizontal">
								<materialIcons:MaterialIcon Kind="Folder"/>
								<TextBlock Text="Browse" Margin="5,0,5,0"/>
							</StackPanel>
						</Button.Content>
					</Button>
				</Grid>

				<StackPanel Spacing="4">
					<TextBlock Text="Combine edit map" Opacity="0.85"/>
					<TextBox Text="{Binding CombineMapPath}" IsReadOnly="True"
							 PlaceholderText="Auto-found beside the video as {name}.combine-map.json (written by Combine)"/>
				</StackPanel>

				<StackPanel Spacing="4">
					<TextBlock Text="Matched LRF proxies" Opacity="0.85"/>
					<ListBox ItemsSource="{Binding MatchedLrfLines}"
							 MinHeight="80"
							 MaxHeight="160"/>
				</StackPanel>

				<StackPanel Spacing="4">
					<TextBlock Text="Output JSON" Opacity="0.85"/>
					<TextBox Text="{Binding OutputJsonPath}" IsReadOnly="True"/>
					<TextBlock Text="YouTube bookmarks" Opacity="0.85" Margin="0,6,0,0"/>
					<TextBox Text="{Binding OutputYoutubePath}" IsReadOnly="True"/>
				</StackPanel>

				<StackPanel Spacing="4">
					<TextBlock Text="Detected events (combined timeline)" Opacity="0.85"/>
					<ListBox ItemsSource="{Binding DetectedEventLines}"
							 MinHeight="140"
							 MaxHeight="280"/>
				</StackPanel>
			</StackPanel>
		</ScrollViewer>
	</DockPanel>
</UserControl>
