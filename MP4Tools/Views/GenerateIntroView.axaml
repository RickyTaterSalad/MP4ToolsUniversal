<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:vm="using:MP4Tools.ViewModels"
			 xmlns:mlib="using:MP4ToolsLib"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
			 mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="560"
			 x:Class="MP4Tools.Views.GenerateIntroView"
			 x:DataType="vm:GenerateIntroViewModel">
	<DockPanel DragDrop.AllowDrop="True"
			   Background="Transparent"
			   DragDrop.DragOver="OnDragOver"
			   DragDrop.Drop="OnDrop"
			   LastChildFill="True">

		<!-- Always-visible action bar -->
		<StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,8,0,0">
			<TextBlock Text="{Binding OperationStatus}"
					   TextWrapping="Wrap"
					   Opacity="0.92"/>
			<!-- Standalone Text Tools actions -->
			<Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding !IsEmbeddedMode}">
				<StackPanel Grid.Column="0" Orientation="Horizontal">
					<Button Command="{Binding StopCommand}" Padding="4" IsEnabled="{Binding CanStop}" Margin="0,0,5,0">
						<Button.Content>
							<StackPanel Orientation="Horizontal">
								<materialIcons:MaterialIcon Kind="Stop"/>
								<TextBlock Text="Stop" Margin="5,0,5,0"/>
							</StackPanel>
						</Button.Content>
					</Button>
					<Button Command="{Binding ClearCommand}" Padding="4" IsEnabled="{Binding CanClear}">
						<Button.Content>
							<StackPanel Orientation="Horizontal">
								<materialIcons:MaterialIcon Kind="Remove"/>
								<TextBlock Text="Clear" Margin="5,0,5,0"/>
							</StackPanel>
						</Button.Content>
					</Button>
				</StackPanel>
				<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
					<Button Command="{Binding AddToCombineCommand}"
							Padding="4"
							IsEnabled="{Binding CanAddToCombine}"
							ToolTip.Tip="Insert the generated intro as the first clip in Combine.">
						<Button.Content>
							<StackPanel Orientation="Horizontal">
								<materialIcons:MaterialIcon Kind="PlaylistPlus"/>
								<TextBlock Text="Add to Combine" Margin="5,0,5,0"/>
							</StackPanel>
						</Button.Content>
					</Button>
					<Button Command="{Binding GenerateCommand}"
							Padding="4"
							IsEnabled="{Binding CanGenerate}">
						<Button.Content>
							<StackPanel Orientation="Horizontal">
								<materialIcons:MaterialIcon Kind="MovieOpen"/>
								<TextBlock Text="Generate Intro" Margin="5,0,5,0"/>
							</StackPanel>
						</Button.Content>
					</Button>
				</StackPanel>
			</Grid>
			<!-- Embedded Replace Segment: save settings only -->
			<StackPanel Orientation="Horizontal"
						HorizontalAlignment="Right"
						Spacing="8"
						IsVisible="{Binding IsEmbeddedMode}">
				<Button Command="{Binding CancelEmbeddedCommand}"
						Padding="4"
						ToolTip.Tip="Return without saving intro settings.">
					<Button.Content>
						<StackPanel Orientation="Horizontal">
							<materialIcons:MaterialIcon Kind="ArrowLeft"/>
							<TextBlock Text="Back" Margin="5,0,5,0"/>
						</StackPanel>
					</Button.Content>
				</Button>
				<Button Command="{Binding ConfirmEmbeddedCommand}"
						Padding="4"
						IsEnabled="{Binding CanConfirmEmbedded}"
						ToolTip.Tip="Save intro settings and return. The video is generated when you Apply Edits.">
					<Button.Content>
						<StackPanel Orientation="Horizontal">
							<materialIcons:MaterialIcon Kind="Check"/>
							<TextBlock Text="Save" Margin="5,0,5,0"/>
						</StackPanel>
					</Button.Content>
				</Button>
			</StackPanel>
		</StackPanel>

		<ScrollViewer VerticalScrollBarVisibility="Auto"
					  HorizontalScrollBarVisibility="Disabled">
			<StackPanel Spacing="0" Margin="0,0,8,0">
				<Border IsVisible="{Binding IsEmbeddedMode}"
						Background="#334A90E2"
						CornerRadius="2"
						Padding="10,8"
						Margin="0,0,0,12">
					<TextBlock Text="{Binding EmbeddedBanner}"
							   TextWrapping="Wrap"
							   Opacity="0.95"/>
				</Border>

				<!-- Reference video (standalone Generate Intro only) -->
				<StackPanel Spacing="8" Margin="0,0,0,12" IsVisible="{Binding !IsEmbeddedMode}">
					<TextBlock Text="Reference video"
							   FontSize="12"
							   FontWeight="SemiBold"
							   Opacity="0.65"
							   LetterSpacing="0.4"/>
					<TextBlock Text="Intro is encoded to match this clip (size, fps, codecs) so Combine can stream-copy it with no re-encode."
							   TextWrapping="Wrap"
							   Opacity="0.75"
							   FontSize="12"/>
					<Grid ColumnDefinitions="*,Auto">
						<TextBox Grid.Column="0"
								 Margin="0,0,10,0"
								 PlaceholderText="Reference clip from your combine set"
								 Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}"/>
						<Button Grid.Column="1" Click="BrowseReferenceButton_OnClick" Padding="4">
							<Button.Content>
								<StackPanel Orientation="Horizontal">
									<materialIcons:MaterialIcon Kind="Video"/>
									<TextBlock Text="Browse" Margin="5,0,5,0"/>
								</StackPanel>
							</Button.Content>
						</Button>
					</Grid>
					<TextBlock Text="{Binding ReferenceProbeSummary}"
							   TextWrapping="Wrap"
							   Opacity="0.8"
							   FontSize="12"
							   IsVisible="{Binding ReferenceProbeSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
				</StackPanel>

				<Separator Margin="0,0,0,12" Opacity="0.45" IsVisible="{Binding !IsEmbeddedMode}"/>

				<!-- Theme + text + style -->
				<Grid ColumnDefinitions="*,Auto,*" Margin="0,0,0,12" ColumnSpacing="16">
					<StackPanel Grid.Column="0" Spacing="10">
						<TextBlock Text="Text"
								   FontSize="12"
								   FontWeight="SemiBold"
								   Opacity="0.65"
								   LetterSpacing="0.4"/>
						<TextBox PlaceholderText="Title"
								 Text="{Binding IntroTitle, UpdateSourceTrigger=PropertyChanged}"/>
						<TextBox PlaceholderText="Subtitle"
								 Text="{Binding IntroSubtitle, UpdateSourceTrigger=PropertyChanged}"/>
						<TextBox PlaceholderText="Details"
								 Text="{Binding IntroDetails, UpdateSourceTrigger=PropertyChanged}"/>
					</StackPanel>

					<Separator Grid.Column="1" Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" Opacity="0.45"/>

					<StackPanel Grid.Column="2" Spacing="10">
						<TextBlock Text="Theme &amp; style"
								   FontSize="12"
								   FontWeight="SemiBold"
								   Opacity="0.65"
								   LetterSpacing="0.4"/>
						<ComboBox ItemsSource="{Binding Themes}"
								  SelectedItem="{Binding SelectedTheme}"
								  HorizontalAlignment="Stretch">
							<ComboBox.ItemTemplate>
								<DataTemplate x:DataType="mlib:IntroTheme">
									<TextBlock Text="{Binding Name}"/>
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>
						<Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
							<TextBlock Grid.Row="0" Grid.Column="0" Text="Title size" VerticalAlignment="Center" Opacity="0.85"/>
							<ComboBox Grid.Row="0" Grid.Column="1"
									  ItemsSource="{Binding FontSizeRange}"
									  SelectedValue="{Binding TitleFontSize}"
									  Width="90"
									  HorizontalAlignment="Left"/>
							<TextBlock Grid.Row="0" Grid.Column="2" Text="Subtitle" VerticalAlignment="Center" Opacity="0.85"/>
							<ComboBox Grid.Row="0" Grid.Column="3"
									  ItemsSource="{Binding FontSizeRange}"
									  SelectedValue="{Binding SubtitleFontSize}"
									  Width="90"
									  HorizontalAlignment="Left"/>

							<TextBlock Grid.Row="1" Grid.Column="0" Text="Details size" VerticalAlignment="Center" Opacity="0.85"/>
							<ComboBox Grid.Row="1" Grid.Column="1"
									  ItemsSource="{Binding FontSizeRange}"
									  SelectedValue="{Binding DetailsFontSize}"
									  Width="90"
									  HorizontalAlignment="Left"/>
							<TextBlock Grid.Row="1" Grid.Column="2" Text="Spacing" VerticalAlignment="Center" Opacity="0.85"/>
							<ComboBox Grid.Row="1" Grid.Column="3"
									  ItemsSource="{Binding LineGapRange}"
									  SelectedValue="{Binding LineGap}"
									  Width="90"
									  HorizontalAlignment="Left"/>

							<TextBlock Grid.Row="2" Grid.Column="0" Text="BG color" VerticalAlignment="Center" Opacity="0.85"/>
							<TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
									 PlaceholderText="0x1E1E1E"
									 Text="{Binding BackgroundColor, UpdateSourceTrigger=PropertyChanged}"/>

							<TextBlock Grid.Row="3" Grid.Column="0" Text="Text color" VerticalAlignment="Center" Opacity="0.85"/>
							<TextBox Grid.Row="3" Grid.Column="1"
									 PlaceholderText="white"
									 Text="{Binding TextColor, UpdateSourceTrigger=PropertyChanged}"/>
							<TextBlock Grid.Row="3" Grid.Column="2" Text="Duration" VerticalAlignment="Center" Opacity="0.85"/>
							<ComboBox Grid.Row="3" Grid.Column="3"
									  ItemsSource="{Binding IntroDurationRange}"
									  SelectedValue="{Binding IntroDurationSeconds}"
									  Width="90"
									  HorizontalAlignment="Left"/>
						</Grid>
					</StackPanel>
				</Grid>

				<!-- Preview -->
				<StackPanel Spacing="6" Margin="0,0,0,12">
					<TextBlock Text="Preview"
							   FontSize="12"
							   FontWeight="SemiBold"
							   Opacity="0.65"
							   LetterSpacing="0.4"/>
					<TextBlock Text="{Binding PreviewStatus}"
							   Opacity="0.75"
							   FontSize="12"/>
					<Border BorderBrush="#55FFFFFF"
							BorderThickness="1"
							CornerRadius="2"
							Background="#22000000"
							MinHeight="120"
							MaxHeight="220"
							Padding="4">
						<Panel>
							<TextBlock Text="Preview will appear here"
									   HorizontalAlignment="Center"
									   VerticalAlignment="Center"
									   Opacity="0.45"
									   IsVisible="{Binding !HasPreviewImage}"/>
							<Image Source="{Binding PreviewImage}"
								   Stretch="Uniform"
								   MaxHeight="210"
								   IsVisible="{Binding HasPreviewImage}"/>
						</Panel>
					</Border>
				</StackPanel>

				<!-- Output (standalone Generate Intro only) -->
				<StackPanel Spacing="6" Margin="0,0,0,8" IsVisible="{Binding !IsEmbeddedMode}">
					<TextBlock Text="Output"
							   FontSize="12"
							   FontWeight="SemiBold"
							   Opacity="0.65"
							   LetterSpacing="0.4"/>
					<TextBox PlaceholderText="Intro MP4 path (Combine-compatible)"
							 Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"/>
				</StackPanel>
			</StackPanel>
		</ScrollViewer>
	</DockPanel>
</UserControl>
