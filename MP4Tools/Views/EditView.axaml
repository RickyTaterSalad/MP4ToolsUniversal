<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:vm="using:MP4Tools.ViewModels"
			 xmlns:views="using:MP4Tools.Views"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="MP4Tools.Views.EditView"
			 x:DataType="vm:EditViewModel">
	<TabControl Margin="0" SelectedIndex="{Binding SelectedTabIndex}">
		<TabItem Header="Rewrite Intro">
			<views:RewriteIntroView DataContext="{Binding RewriteIntroViewModel}" Margin="8"/>
		</TabItem>
		<TabItem Header="Replace Segment">
			<views:ReplaceSegmentView DataContext="{Binding ReplaceSegmentViewModel}" Margin="8"/>
		</TabItem>
	</TabControl>
</UserControl>
