<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="MP4Tools.Views.EventInfoDefaultsWindow"
        Title="Event Info Defaults"
        Width="360"
        Height="280"
        MinWidth="280"
        MinHeight="200"
        WindowStartupLocation="CenterOwner"
        CanResize="True">
	<DockPanel Margin="16">
		<StackPanel DockPanel.Dock="Bottom"
					Orientation="Horizontal"
					HorizontalAlignment="Right"
					Spacing="8"
					Margin="0,12,0,0">
			<Button Content="Cancel"
					MinWidth="88"
					Click="CancelButton_OnClick"/>
			<Button x:Name="SelectButton"
					Content="Select"
					MinWidth="88"
					IsEnabled="False"
					Click="SelectButton_OnClick"/>
		</StackPanel>
		<StackPanel Spacing="8">
			<TextBlock Text="Select a default value"
					   Opacity="0.75"/>
			<ListBox x:Name="DefaultsList"
					 DoubleTapped="DefaultsList_OnDoubleTapped"
					 SelectionChanged="DefaultsList_OnSelectionChanged"
					 KeyDown="DefaultsList_OnKeyDown">
				<ListBox.ItemTemplate>
					<DataTemplate>
						<TextBlock Text="{Binding}" Margin="4,6"/>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</StackPanel>
	</DockPanel>
</Window>
