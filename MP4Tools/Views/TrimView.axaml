<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:mlib="using:MP4ToolsLib"
			 xmlns:vm="using:MP4Tools.ViewModels"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
       mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
       x:Class="MP4Tools.Views.TrimView"
			 x:DataType="vm:TrimViewModel">
	<Grid DragDrop.AllowDrop="True"
		 Background="Transparent"
		 DragDrop.DragOver="OnDragOver"
		 DragDrop.Drop="OnDrop"
	>
	<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="auto"/>
			<ColumnDefinition Width="auto"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>
		<Grid Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3"	Margin="0,0,0,10">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="auto"/>
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition Height="auto"/>
				<RowDefinition Height="auto"/>
			</Grid.RowDefinitions>
			<StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
				<TextBox PlaceholderText="Input Video" Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}"/>
			</StackPanel>
			<Button Grid.Column="1" Grid.Row="1" Click="BrowseButton_OnClick" Padding="4">
				<Button.Content>
					<StackPanel Orientation="Horizontal">
						<materialIcons:MaterialIcon Kind="Video"/>
						<TextBlock Text="Browse" Margin="5,0,5,0"/>
					</StackPanel>
				</Button.Content>
			</Button>
		</Grid>
		<StackPanel Grid.Column="0" Grid.Row="2">
			<Border BorderThickness=".35" BorderBrush="gray" CornerRadius="2" Padding="3">
				<StackPanel>
					<TextBlock Text="Create New Trim Range" Grid.Row="1" VerticalAlignment="Center" Margin="5,5,10,10"/>
					<StackPanel Orientation="Horizontal" Margin="0,0,0,0" VerticalAlignment="Top">
						<materialIcons:MaterialIcon Kind="Play" VerticalAlignment="Center" Margin="0,0,10,0"/>
						<ComboBox ItemsSource="{Binding VideoHourRange}" Width="50" SelectedValue="{Binding StartRange.Hours}" IsEnabled="{Binding IsHoursRangeEnabled}"/>
						<Label Content=" h " VerticalAlignment="Bottom"/>
						<ComboBox ItemsSource="{Binding VideoMinuteRange}" Width="50" SelectedValue="{Binding StartRange.Minutes}"/>
						<Label Content=" m " VerticalAlignment="Bottom"/>
						<ComboBox ItemsSource="{Binding Range}" Width="50" SelectedValue="{Binding StartRange.Seconds}"/>
						<Label Content=" s " VerticalAlignment="Bottom"/>
						<materialIcons:MaterialIcon Kind="Stop" VerticalAlignment="Center" Margin="20,0,10,0"/>
						<ComboBox ItemsSource="{Binding VideoHourRange}" Width="50" SelectedValue="{Binding EndRange.Hours}" IsEnabled="{Binding IsHoursRangeEnabled}"/>
						<Label Content=" h " VerticalAlignment="Bottom"/>
						<ComboBox ItemsSource="{Binding VideoMinuteRange}" Width="50" SelectedValue="{Binding EndRange.Minutes}"/>
						<Label Content=" m " VerticalAlignment="Bottom"/>
						<ComboBox ItemsSource="{Binding Range}" Width="50" SelectedValue="{Binding EndRange.Seconds}"/>
						<Label Content=" s " VerticalAlignment="Bottom"/>
					</StackPanel>
					<Grid Margin="25,0,0,0">
						<Grid.RowDefinitions>
							<RowDefinition Height="auto"/>
							<RowDefinition Height="auto"/>
							<RowDefinition Height="auto"/>
							<RowDefinition Height="auto"/>
						</Grid.RowDefinitions>
						<TextBox PlaceholderText="Label" Text="{Binding RangeLabel}" Grid.Row="1" HorizontalAlignment="Stretch" Margin="0,10,30,10"/>
					</Grid>
				</StackPanel>
			</Border>
		</StackPanel>
		<StackPanel Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Margin="10,0,0,0">
			<StackPanel Margin="0,0,0,10" Orientation="Horizontal">
				<Button Command="{Binding ResetTimeRangeCommand}" ToolTip.Tip="Reset Range">
					<Button.Content>
						<StackPanel Orientation="Horizontal">
							<materialIcons:MaterialIcon Kind="Undo"/>
						</StackPanel>
					</Button.Content>
				</Button>
				<Button Click="ImportButton_OnClick" Padding="4" Margin="5,0,0,0" ToolTip.Tip="Import">
					<Button.Content>
						<StackPanel Orientation="Horizontal">
							<materialIcons:MaterialIcon Kind="Import"/>
						</StackPanel>
					</Button.Content>
				</Button>
				<Button Click="ExportButton_OnClick" Padding="4" Margin="5,0,0,0" ToolTip.Tip="Export">
					<Button.Content>
						<StackPanel Orientation="Horizontal">
							<materialIcons:MaterialIcon Kind="Export"/>
						</StackPanel>
					</Button.Content>
				</Button>
			</StackPanel>
			<Button Command="{Binding AddTimeRangeCommand}" Padding="4" VerticalAlignment="Top" ToolTip.Tip="Add Range">
				<Button.Content>
					<StackPanel Orientation="Horizontal">
						<materialIcons:MaterialIcon Kind="Add"/>
					</StackPanel>
				</Button.Content>
			</Button>
			<Button Command="{Binding RemoveTimeRangeCommand}" Padding="4" Margin="0,5" IsEnabled="{Binding HasSelectedRange}" ToolTip.Tip="Remove Selected">
				<Button.Content>
					<StackPanel Orientation="Horizontal">
						<materialIcons:MaterialIcon Kind="Remove"/>
					</StackPanel>
				</Button.Content>
			</Button>
			<Button Command="{Binding ClearTimeRangesCommand}" Padding="4" Margin="0,5,0,30" ToolTip.Tip="Remove All">
				<Button.Content>
					<StackPanel Orientation="Horizontal">
						<materialIcons:MaterialIcon Kind="Trash"/>
					</StackPanel>
				</Button.Content>
			</Button>
		</StackPanel>
		<StackPanel Grid.Row="2" Grid.Column="2" Margin="10,0,0,0">
			<ListBox MinHeight="250" MaxHeight="250" ItemsSource="{Binding TrimRanges}" SelectedItem="{Binding SelectedStartStopRange}">
				<ListBox.ItemTemplate>
					<DataTemplate x:DataType="mlib:StartStopRange">
						<StackPanel Orientation="Horizontal" Margin="5"
									Background="Transparent"
									PointerPressed="OnListBoxItemPointerPressed"
									DragDrop.AllowDrop="True"
									DragDrop.DragOver="OnListBoxItemDragOver"
									DragDrop.Drop="OnListBoxItemDrop">
							<TextBlock Text="{Binding StartRange}" VerticalAlignment="Center"/>
							<TextBlock Text=" - " VerticalAlignment="Center"/>
							<TextBlock Text="{Binding EndRange}" VerticalAlignment="Center"/>
							<TextBox PlaceholderText="Label" Text="{Binding Label}" MinWidth="180" Margin="10,0,0,0"/>
						</StackPanel>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
			<Label Content="Out Folder" Grid.Row="0" Margin="0,10,0,5"/>
			<TextBox PlaceholderText="Output Folder" Text="{Binding OutputFolderName}" Grid.Row="1" HorizontalAlignment="Stretch"/>
		</StackPanel>
		<TextBlock Grid.Row="5" Grid.ColumnSpan="3"
				   Text="{Binding OperationStatus}"
				   TextWrapping="Wrap"
				   Margin="0,12,0,8"
				   Opacity="0.92"/>
		<StackPanel Orientation="Horizontal" Grid.Row="6" HorizontalAlignment="Left">
			<Button Command="{Binding StopCommand}" Padding="4" IsEnabled="{Binding CanStop}" Margin="0,0,5,0">
				<Button.Content>
					<StackPanel Orientation="Horizontal">
						<materialIcons:MaterialIcon Kind="Stop"/>
						<TextBlock Text="Stop" Margin="5,0,5,0"/>
					</StackPanel>
				</Button.Content>
			</Button>
			<Button Command="{Binding ClearCommand}" Padding="4" IsEnabled="{Binding CanClear}">
				<Button.Content>
					<StackPanel Orientation="Horizontal">
						<materialIcons:MaterialIcon Kind="Remove"/>
						<TextBlock Text="Clear" Margin="5,0,5,0"/>
					</StackPanel>
				</Button.Content>
			</Button>
		</StackPanel>
		<StackPanel Orientation="Horizontal" Grid.Row="6" Grid.ColumnSpan="3" HorizontalAlignment="Right" >
			<Button Margin="10,0,0,0" Command="{Binding TrimCommand}" Padding="4" IsEnabled="{Binding CanTrim}">
				<Button.Content>
					<StackPanel Orientation="Horizontal">
						<materialIcons:MaterialIcon Kind="Scissors"/>
						<TextBlock Text="Trim" Margin="5,0,5,0"/>
					</StackPanel>
				</Button.Content>
			</Button>
			<Button Margin="10,0,0,0" Command="{Binding TrimAndCombineCommand}" Padding="4" IsEnabled="{Binding CanTrim}">
				<Button.Content>
					<StackPanel Orientation="Horizontal">
						<materialIcons:MaterialIcon Kind="Scissors"/>
						<TextBlock Text="Trim And Combine" Margin="5,0,5,0"/>
					</StackPanel>
				</Button.Content>
			</Button>
		</StackPanel>
	</Grid>
</UserControl>
