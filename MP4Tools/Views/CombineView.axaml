<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MP4Tools.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	  xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    mc:Ignorable="d"
    x:Class="MP4Tools.Views.CombineView"
    x:DataType="vm:CombineViewModel">
	<Grid DragDrop.AllowDrop="True"
		 Background="Transparent"
		 DragDrop.DragOver="OnDragOver"
		 DragDrop.Drop="OnDrop">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<Grid Grid.Row="0" Margin="0,0,0,10">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>
			<TextBox Grid.Row="0" Grid.Column="0" Margin="0,0,10,0"
					 PlaceholderText="Source video folder or single .mp4/.mov"
					 Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}"
					 ToolTip.Tip="Folder of clips to concatenate, or one video file when adding an intro screen."/>
			<Button Grid.Row="0" Grid.Column="1" Click="BrowseButton_OnClick" Padding="4" Margin="0,0,15,0">
				<Button.Content>
					<StackPanel Orientation="Horizontal">
						<materialIcons:MaterialIcon Kind="Folder"/>
						<TextBlock Text="Browse" Margin="5,0,5,0" />
					</StackPanel>
				</Button.Content>
			</Button>
			<TextBox Grid.Row="0" Grid.Column="2" Margin="0,0,10,0"
					 PlaceholderText="Recording JSON (file, /share/…, or /recordings/… URL)"
					 Text="{Binding RecordingJsonPath, UpdateSourceTrigger=PropertyChanged}"
					 ToolTip.Tip="Local .json file, public /share/{token} link, or recording page /recordings/{id} (API key required for page/API URLs)."/>
			<Button Grid.Row="0" Grid.Column="3" Click="BrowseJsonButton_OnClick" Padding="4">
				<Button.Content>
					<StackPanel Orientation="Horizontal">
						<materialIcons:MaterialIcon Kind="FileCode"/>
						<TextBlock Text="Browse" Margin="5,0,5,0" />
					</StackPanel>
				</Button.Content>
			</Button>
			<TextBox Grid.Row="1" Grid.Column="2" Margin="0,8,10,0"
					 PlaceholderText="Box score image (JPEG, PNG, WebP, or GIF)"
					 Text="{Binding BoxScoreImagePath, UpdateSourceTrigger=PropertyChanged}"
					 ToolTip.Tip="When set, uploaded to Baseball Logger with the modified recording JSON after Combine (requires API key in Options)"/>
			<Button Grid.Row="1" Grid.Column="3" Click="BrowseBoxScoreButton_OnClick" Padding="4" Margin="0,8,0,0">
				<Button.Content>
					<StackPanel Orientation="Horizontal">
						<materialIcons:MaterialIcon Kind="Image"/>
						<TextBlock Text="Browse" Margin="5,0,5,0" />
					</StackPanel>
				</Button.Content>
			</Button>
		</Grid>

		<StackPanel Grid.Row="1" Margin="0,0,0,8">
			<StackPanel Orientation="Horizontal" Margin="0,5,0,0">
				<StackPanel Margin="10,0,30,0">
					<TextBlock Text="Start Video Skip" Margin="0,0,0,4"/>
					<StackPanel Orientation="Horizontal">
						<ToggleSwitch IsChecked="{Binding TrimFirstVideo}" OffContent="" OnContent="" VerticalAlignment="Center" />
						<StackPanel Orientation="Horizontal" IsEnabled="{Binding TrimFirstVideo}" VerticalAlignment="Center" Margin="10,0,0,0">
							<ComboBox ItemsSource="{Binding StartVideoMinuteRange}" SelectedValue="{Binding StartRange.Minutes}" Width="50" VerticalAlignment="Center"/>
							<TextBlock Text=" m " VerticalAlignment="Center"/>
							<ComboBox ItemsSource="{Binding StartVideoSecondRange}" SelectedValue="{Binding StartRange.Seconds}" Width="50" VerticalAlignment="Center"/>
							<TextBlock Text=" s " VerticalAlignment="Center"/>
						</StackPanel>
					</StackPanel>
				</StackPanel>
				<StackPanel>
					<TextBlock Text="End Video Duration" Margin="0,0,0,4"/>
					<StackPanel Orientation="Horizontal">
						<ToggleSwitch IsChecked="{Binding TrimLastVideo}" OffContent="" OnContent="" VerticalAlignment="Center" />
						<StackPanel Orientation="Horizontal" IsEnabled="{Binding TrimLastVideo}" VerticalAlignment="Center" Margin="10,0,0,0">
							<ComboBox ItemsSource="{Binding EndVideoMinuteRange}" SelectedValue="{Binding EndRange.Minutes}" Width="50" VerticalAlignment="Center"/>
							<TextBlock Text=" m " VerticalAlignment="Center"/>
							<ComboBox ItemsSource="{Binding EndVideoSecondRange}" SelectedValue="{Binding EndRange.Seconds}" Width="50" VerticalAlignment="Center"/>
							<TextBlock Text=" s " VerticalAlignment="Center"/>
						</StackPanel>
					</StackPanel>
				</StackPanel>
			</StackPanel>
			<!-- Game Info Section -->
			<StackPanel Margin="10,5,0,10">
				<StackPanel Orientation="Horizontal" Margin="0,10,0,10" Spacing="10">
					<CalendarDatePicker SelectedDate="{Binding EventDate}" MinWidth="150" PlaceholderText="Date"/>
					<TextBox PlaceholderText="Event Info" Text="{Binding EventInfo, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
				</StackPanel>
				<StackPanel Orientation="Horizontal" Spacing="10">
					<TextBox PlaceholderText="Visitor" Text="{Binding VisitorName, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
					<TextBox PlaceholderText="Runs" Text="{Binding VisitorScore, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
					<TextBox PlaceholderText="Home" Text="{Binding HomeName, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
					<TextBox PlaceholderText="Runs" Text="{Binding HomeScore, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
				</StackPanel>
			</StackPanel>
			<StackPanel Spacing="8">
				<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
					<ToggleSwitch IsChecked="{Binding IncludeIntro}" OffContent="" OnContent="" VerticalAlignment="Center" />
					<TextBlock Text="Intro Screen" VerticalAlignment="Center" />
				</StackPanel>
				<StackPanel Spacing="8" IsVisible="{Binding IncludeIntro}">
					<StackPanel Orientation="Horizontal" Spacing="10">
						<TextBox PlaceholderText="Title"
								 Width="270"
								 Text="{Binding IntroTitle, UpdateSourceTrigger=PropertyChanged}"/>
						<TextBox PlaceholderText="Subtitle"
								 Width="270"
								 Text="{Binding IntroSubtitle, UpdateSourceTrigger=PropertyChanged}"/>
					</StackPanel>
					<StackPanel Orientation="Horizontal" Spacing="10">
						<TextBox PlaceholderText="Details"
								 Width="270"
								 Text="{Binding IntroDetails, UpdateSourceTrigger=PropertyChanged}"
								 VerticalAlignment="Center"/>
						<StackPanel Orientation="Horizontal"
									VerticalAlignment="Center">
							<TextBlock Text="Intro Duration" VerticalAlignment="Center" Margin="0,0,8,0"/>
							<ComboBox ItemsSource="{Binding IntroDurationRange}"
									  SelectedValue="{Binding IntroDurationSeconds}"
									  Width="80"/>
						</StackPanel>
					</StackPanel>
				</StackPanel>
			</StackPanel>
		</StackPanel>

		<Grid Grid.Row="2" Margin="0,5,0,5" ColumnDefinitions="Auto,*,Auto">
			<StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
				<Button Command="{Binding RemoveSelectedFileCommand}" Padding="5" ToolTip.Tip="Remove Selected File">
					<materialIcons:MaterialIcon Kind="Remove"/>
				</Button>
				<Label Content="Input Files" VerticalAlignment="Center" Margin="5,0,0,0"/>
			</StackPanel>
			<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
				<TextBlock Text="Sort" VerticalAlignment="Center" Opacity="0.85"/>
				<ComboBox ItemsSource="{Binding InputFileSortOptions}"
						  SelectedItem="{Binding SelectedInputFileSort}"
						  MinWidth="120"
						  VerticalAlignment="Center"/>
			</StackPanel>
		</Grid>

		<ListBox Grid.Row="3"
				 ItemsSource="{Binding InputFiles}"
				 SelectedItem="{Binding SelectedInputFile}">
			<ListBox.ItemTemplate>
				<DataTemplate>
					<StackPanel Orientation="Horizontal"
								Background="Transparent"
								PointerPressed="OnListBoxItemPointerPressed"
								DragDrop.AllowDrop="True"
								DragDrop.DragOver="OnListBoxItemDragOver"
								DragDrop.Drop="OnListBoxItemDrop">
						<TextBlock Text="{Binding Name}"/>
					</StackPanel>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>

		<Label Content="Output Path" Grid.Row="4" Margin="0,5,0,5"/>
		<TextBox Grid.Row="5"
				 Margin="0,0,0,8"
				 PlaceholderText="Combined Output File"
				 Text="{Binding OutputPath}" />
		<TextBlock Grid.Row="6"
				   Text="{Binding OperationStatus}"
				   TextWrapping="Wrap"
				   Margin="0,4,0,8"
				   Opacity="0.92"/>
		<Grid Grid.Row="7" ColumnDefinitions="*,Auto">
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
				<Button Command="{Binding StopCommand}" Padding="4" IsEnabled="{Binding CanStop}" Margin="0,0,5,0">
					<Button.Content>
						<StackPanel Orientation="Horizontal">
							<materialIcons:MaterialIcon Kind="Stop"/>
							<TextBlock Text="Stop" Margin="5,0,5,0" />
						</StackPanel>
					</Button.Content>
				</Button>
				<Button Command="{Binding ClearCommand}" Padding="4" IsEnabled="{Binding CanClear}">
					<Button.Content>
						<StackPanel Orientation="Horizontal">
							<materialIcons:MaterialIcon Kind="Remove"/>
							<TextBlock Text="Clear" Margin="5,0,5,0" />
						</StackPanel>
					</Button.Content>
				</Button>
			</StackPanel>
			<Button Grid.Column="1" Margin="10,0,0,0" Command="{Binding CombineCommand}" Padding="4" IsEnabled="{Binding CanCombine}">
				<Button.Content>
					<StackPanel Orientation="Horizontal">
						<materialIcons:MaterialIcon Kind="VectorCombine"/>
						<TextBlock Text="Combine" Margin="5,0,5,0" />
					</StackPanel>
				</Button.Content>
			</Button>
		</Grid>
	</Grid>
</UserControl>
