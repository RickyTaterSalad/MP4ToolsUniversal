<UserControl xmlns="https://github.com/avaloniaui"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
						 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
						 xmlns:vm="using:MP4Tools.ViewModels"
						 xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
						 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="220"
						 x:Class="MP4Tools.Views.OptionsView"
						 x:DataType="vm:OptionsViewModel">
	<ScrollViewer>
		<StackPanel Margin="0,0,16,16" Spacing="14">
			<TextBlock Text="Temporary files" FontWeight="SemiBold" FontSize="16"/>

			<TextBlock TextWrapping="Wrap"
								 Text="Leave the folder empty to use the system temporary directory. Files created during combine and trim are written here."/>

			<Grid ColumnDefinitions="*,Auto,Auto">
				<TextBox Grid.Column="0"
								 PlaceholderText="System default"
								 Text="{Binding TempDirectory, UpdateSourceTrigger=PropertyChanged}"
								 Margin="0,0,8,0"/>
				<Button Grid.Column="1"
								Command="{Binding BrowseTempFolderCommand}"
								Padding="10,6"
								Margin="0,0,8,0">
					<StackPanel Orientation="Horizontal">
						<materialIcons:MaterialIcon Kind="FolderOpen"/>
						<TextBlock Text="Browse…" Margin="6,0,0,0"/>
					</StackPanel>
				</Button>
				<Button Grid.Column="2"
								Command="{Binding ClearTempFolderPathCommand}"
								Padding="10,6">
					<TextBlock Text="Use system default"/>
				</Button>
			</Grid>

			<CheckBox Content="Keep temporary files after processing (do not delete intermediates)"
								IsChecked="{Binding RetainTemporaryFiles}"/>

			<TextBlock Text="Default output folder" FontWeight="SemiBold" FontSize="16"/>
			<TextBlock TextWrapping="Wrap"
								 Text="Combine builds output paths here; Trim writes each session under this folder. Leave empty to use the built-in default (/opt/Encodes)."/>

			<Grid ColumnDefinitions="*,Auto,Auto">
				<TextBox Grid.Column="0"
								 PlaceholderText="/opt/Encodes"
								 Text="{Binding DefaultOutputDirectory, UpdateSourceTrigger=PropertyChanged}"
								 Margin="0,0,8,0"/>
				<Button Grid.Column="1"
								Command="{Binding BrowseDefaultOutputFolderCommand}"
								Padding="10,6"
								Margin="0,0,8,0">
					<StackPanel Orientation="Horizontal">
						<materialIcons:MaterialIcon Kind="FolderOpen"/>
						<TextBlock Text="Browse…" Margin="6,0,0,0"/>
					</StackPanel>
				</Button>
				<Button Grid.Column="2"
								Command="{Binding ClearDefaultOutputFolderPathCommand}"
								Padding="10,6">
					<TextBlock Text="Use built-in default"/>
				</Button>
			</Grid>

			<TextBlock Text="FFmpeg / ffprobe" FontWeight="SemiBold" FontSize="16"/>
			<CheckBox Content="Dry run — log full ffmpeg and ffprobe command lines without running them"
								IsChecked="{Binding DryRunFfmpegCommands}"/>
			<TextBlock TextWrapping="Wrap" Opacity="0.75" FontSize="12"
								 Text="Trim/Combine and related steps will not produce media output while dry run is on. Encoder detection is skipped, so hardware encoder choices may fall back to software in logs only."/>

			<Button Command="{Binding SaveSettingsCommand}"
							HorizontalAlignment="Left"
							Padding="16,8">
				<TextBlock Text="Save settings"/>
			</Button>

			<TextBlock Text="Configuration file" Opacity="0.85" FontSize="12"/>
			<TextBlock Text="{Binding SettingsFilePathDisplay}"
								 TextWrapping="Wrap"
								 Opacity="0.75"
								 FontSize="11"/>
			<TextBlock TextWrapping="Wrap"
								 Opacity="0.65"
								 FontSize="11"
								 Text="Settings are loaded when the application starts. Click Save to apply changes for this session and future launches."/>
		</StackPanel>
	</ScrollViewer>
</UserControl>
