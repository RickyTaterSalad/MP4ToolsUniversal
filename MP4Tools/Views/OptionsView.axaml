<UserControl xmlns="https://github.com/avaloniaui"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
						 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
						 xmlns:vm="using:MP4Tools.ViewModels"
						 xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
						 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="220"
						 x:Class="MP4Tools.Views.OptionsView"
						 x:DataType="vm:OptionsViewModel">
	<ScrollViewer>
		<StackPanel Margin="0,0,16,16" Spacing="14">
			<TextBlock Text="Temporary files" FontWeight="SemiBold" FontSize="16"/>

			<TextBlock TextWrapping="Wrap"
								 Text="Leave the folder empty to use the system temporary directory. Files created during combine and trim are written here."/>

			<Grid ColumnDefinitions="*,Auto,Auto">
				<TextBox Grid.Column="0"
								 PlaceholderText="System default"
								 Text="{Binding TempDirectory, UpdateSourceTrigger=PropertyChanged}"
								 Margin="0,0,8,0"/>
				<Button Grid.Column="1"
								Command="{Binding BrowseTempFolderCommand}"
								Padding="10,6"
								Margin="0,0,8,0">
					<StackPanel Orientation="Horizontal">
						<materialIcons:MaterialIcon Kind="FolderOpen"/>
						<TextBlock Text="Browse…" Margin="6,0,0,0"/>
					</StackPanel>
				</Button>
				<Button Grid.Column="2"
								Command="{Binding ClearTempFolderPathCommand}"
								Padding="10,6">
					<TextBlock Text="Use system default"/>
				</Button>
			</Grid>

			<CheckBox Content="Keep temporary files after processing (do not delete intermediates)"
								IsChecked="{Binding RetainTemporaryFiles}"/>

			<TextBlock Text="Default output folder" FontWeight="SemiBold" FontSize="16"/>
			<TextBlock TextWrapping="Wrap"
								 Text="Combine builds output paths here; Trim writes each session under this folder. Leave empty to use the built-in default (/opt/Encodes)."/>

			<Grid ColumnDefinitions="*,Auto,Auto">
				<TextBox Grid.Column="0"
								 PlaceholderText="/opt/Encodes"
								 Text="{Binding DefaultOutputDirectory, UpdateSourceTrigger=PropertyChanged}"
								 Margin="0,0,8,0"/>
				<Button Grid.Column="1"
								Command="{Binding BrowseDefaultOutputFolderCommand}"
								Padding="10,6"
								Margin="0,0,8,0">
					<StackPanel Orientation="Horizontal">
						<materialIcons:MaterialIcon Kind="FolderOpen"/>
						<TextBlock Text="Browse…" Margin="6,0,0,0"/>
					</StackPanel>
				</Button>
				<Button Grid.Column="2"
								Command="{Binding ClearDefaultOutputFolderPathCommand}"
								Padding="10,6">
					<TextBlock Text="Use built-in default"/>
				</Button>
			</Grid>

			<CheckBox Content="Open output folder when Combine/Trim completes successfully"
								IsChecked="{Binding OpenOutputFolderOnComplete}"/>

			<CheckBox Content="Delete segment clips after successful Trim And Combine"
								IsChecked="{Binding DeleteTrimSegmentsAfterTrimAndCombine}"
								ToolTip.Tip="Does not apply to Trim-only runs."/>

			<TextBlock Text="Encoding" FontWeight="SemiBold" FontSize="16"/>
			<CheckBox Content="Resolve-safe encoding (re-encode for DaVinci Resolve)"
								IsChecked="{Binding UseResolveSafeEncoding}"
								ToolTip.Tip="When enabled, trim re-encodes video to clean 8-bit HEVC MP4. Combine always uses stream copy. When disabled, trim uses fast stream-copy (may crash or misalign in Resolve)."/>

			<Button Command="{Binding SaveSettingsCommand}"
							HorizontalAlignment="Left"
							Padding="16,8">
				<TextBlock Text="Save settings"/>
			</Button>

			<TextBlock Text="Configuration file" Opacity="0.85" FontSize="12"/>
			<TextBlock Text="{Binding SettingsFilePathDisplay}"
								 TextWrapping="Wrap"
								 Opacity="0.75"
								 FontSize="11"/>
			<TextBlock TextWrapping="Wrap"
								 Opacity="0.65"
								 FontSize="11"
								 Text="Click Save to write settings to disk and apply them immediately (output paths, temp folder, and behavior flags update without restarting)."/>
		</StackPanel>
	</ScrollViewer>
</UserControl>
