<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MP4Tools.ViewModels"
        xmlns:views="using:MP4Tools.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
			  Height="750"
				Width="1200"
        x:Class="MP4Tools.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/projectIcon.ico"
        Title="MP4Tools">

    <TabControl Margin="10">

        <TabItem Header="Combine">
            <views:CombineView DataContext="{Binding CombineViewModel}" Margin="10"/>
        </TabItem>
        <TabItem Header="Trim">
            <views:TrimView DataContext="{Binding TrimViewModel}" Margin="10"/>
        </TabItem>
       <!-- <TabItem Header="Encode">
            <views:EncodeView DataContext="{Binding EncodeViewModel}" Margin="10"/>
        </TabItem> -->
        <TabItem Header="Options">
            <views:OptionsView DataContext="{Binding OptionsViewModel}" Margin="10"/>
        </TabItem>
        <TabItem Header="Log">
            <views:LogView DataContext="{Binding LogViewModel}" Margin="10"/>
        </TabItem>
    </TabControl>

</Window>
