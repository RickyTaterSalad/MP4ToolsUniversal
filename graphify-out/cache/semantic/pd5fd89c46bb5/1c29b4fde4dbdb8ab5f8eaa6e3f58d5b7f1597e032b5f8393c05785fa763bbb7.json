{"nodes": [{"id": "mp4tools_notes_1_vs_1_working_analysis_1_mp4", "label": "1.mp4", "file_type": "concept", "source_file": "MP4Tools/Notes/1_vs_1_working_analysis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stream-copied trim (-c:v copy) producing a malformed 10-bit HEVC MP4 with broken timeline; DaVinci Resolve crashes on import due to mux/timing issues rather than resolution or Opus alone."}, {"id": "mp4tools_notes_1_vs_1_working_analysis_1_working_mp4", "label": "1_working.mp4", "file_type": "concept", "source_file": "MP4Tools/Notes/1_vs_1_working_analysis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full libx265 re-encode (CRF 18) with clean MP4 structure (ctts present, colr BT.709, exact 3840x2160 8-bit Main); works in DaVinci Resolve."}, {"id": "mp4tools_notes_1_vs_1_working_analysis_davinci_resolve", "label": "DaVinci Resolve", "file_type": "concept", "source_file": "MP4Tools/Notes/1_vs_1_working_analysis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NLE parser less tolerant than ffmpeg/ffprobe of broken HEVC-in-MP4 mux/timing; crashes on 1.mp4 import."}, {"id": "mp4tools_notes_1_vs_1_working_analysis_stream_copy_trim", "label": "Stream copy trim", "file_type": "rationale", "source_file": "MP4Tools/Notes/1_vs_1_working_analysis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ffmpeg -ss before -i with -c:v copy grabs extra open-GOP frames and yields incomplete remux (missing ctts/colr, bad edit list); unsafe for Resolve."}, {"id": "mp4tools_notes_1_vs_1_working_analysis_libx265_reencode", "label": "libx265 re-encode", "file_type": "rationale", "source_file": "MP4Tools/Notes/1_vs_1_working_analysis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Preferred fix for Resolve: re-encode with libx265 CRF 18 yuv420p to rebuild clean container timing; safer than stream-copy trim."}, {"id": "mp4tools_notes_1_vs_1_working_analysis_ctts_box", "label": "ctts box", "file_type": "concept", "source_file": "MP4Tools/Notes/1_vs_1_working_analysis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Composition timestamp table required when B-frames are present; without it presentation order is undefined in MP4 \u2014 known NLE/Resolve failure mode for HEVC."}, {"id": "mp4tools_notes_1_vs_1_working_analysis_colr_box", "label": "colr box", "file_type": "concept", "source_file": "MP4Tools/Notes/1_vs_1_working_analysis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Color metadata atom (BT.709 in working file); missing in crash file usually causes color issues not crashes, but signals incomplete remux."}, {"id": "mp4tools_notes_1_vs_1_working_analysis_edit_list", "label": "Edit list", "file_type": "concept", "source_file": "MP4Tools/Notes/1_vs_1_working_analysis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In 1.mp4 video edit list uses media_time=53925 and duration=27028 (90k timescale) to hide in-GOP start and extra stream-copy frames; Resolve tolerates this poorly."}, {"id": "mp4tools_notes_1_vs_1_working_analysis_b_frames", "label": "B-frames", "file_type": "concept", "source_file": "MP4Tools/Notes/1_vs_1_working_analysis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "mp4tools_notes_1_vs_1_working_analysis_hevc_main_10", "label": "HEVC Main 10", "file_type": "concept", "source_file": "MP4Tools/Notes/1_vs_1_working_analysis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "10-bit Main 10 @ L5.2 High tier with stored height 2176 padding; finicky in some apps and a plausible crash co-factor with broken mux."}, {"id": "mp4tools_notes_1_vs_1_working_analysis_hevc_main_8bit", "label": "HEVC Main 8-bit", "file_type": "concept", "source_file": "MP4Tools/Notes/1_vs_1_working_analysis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "mp4tools_notes_1_vs_1_working_analysis_ffmpeg", "label": "ffmpeg", "file_type": "concept", "source_file": "MP4Tools/Notes/1_vs_1_working_analysis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "mp4tools_notes_1_vs_1_working_analysis_broken_mp4_timeline", "label": "Broken MP4 timeline", "file_type": "rationale", "source_file": "MP4Tools/Notes/1_vs_1_working_analysis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Most likely Resolve crash cause: container/timing (missing ctts with B-frames, bad edit list, extra samples from open-GOP stream copy), not codec name alone."}, {"id": "mp4tools_notes_1_vs_1_working_analysis_open_gop", "label": "Open GOP", "file_type": "concept", "source_file": "MP4Tools/Notes/1_vs_1_working_analysis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stream copy at cut point must grab extra frames from an open GOP, yielding 828 samples vs expected ~810 for ~27s at 29.97 fps."}, {"id": "mp4tools_notes_1_vs_1_working_analysis_opus_audio", "label": "Opus audio", "file_type": "concept", "source_file": "MP4Tools/Notes/1_vs_1_working_analysis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Less likely crash factor here because working file also uses Opus; Option C suggests strip-audio test to isolate HEVC/mux vs audio."}, {"id": "mp4tools_notes_1_vs_1_working_analysis_ss_after_input", "label": "-ss after -i trim", "file_type": "rationale", "source_file": "MP4Tools/Notes/1_vs_1_working_analysis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If video must be stream-copied, put -ss after -i; may still get GOP-edge weirdness \u2014 re-encoding remains safer for Resolve."}], "edges": [{"source": "mp4tools_notes_1_vs_1_working_analysis_1_mp4", "target": "mp4tools_notes_1_vs_1_working_analysis_stream_copy_trim", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "MP4Tools/Notes/1_vs_1_working_analysis.md", "source_location": null, "weight": 1.0}, {"source": "mp4tools_notes_1_vs_1_working_analysis_1_working_mp4", "target": "mp4tools_notes_1_vs_1_working_analysis_libx265_reencode", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "MP4Tools/Notes/1_vs_1_working_analysis.md", "source_location": null, "weight": 1.0}, {"source": "mp4tools_notes_1_vs_1_working_analysis_davinci_resolve", "target": "mp4tools_notes_1_vs_1_working_analysis_1_mp4", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "MP4Tools/Notes/1_vs_1_working_analysis.md", "source_location": null, "weight": 1.0}, {"source": "mp4tools_notes_1_vs_1_working_analysis_broken_mp4_timeline", "target": "mp4tools_notes_1_vs_1_working_analysis_1_mp4", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "MP4Tools/Notes/1_vs_1_working_analysis.md", "source_location": null, "weight": 1.0}, {"source": "mp4tools_notes_1_vs_1_working_analysis_broken_mp4_timeline", "target": "mp4tools_notes_1_vs_1_working_analysis_davinci_resolve", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "MP4Tools/Notes/1_vs_1_working_an